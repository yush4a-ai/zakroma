{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Интерфейс с сервера может слушать горячие клавиши программы",
  "windows": ["main"],
  "remote": {
    "urls": ["https://zakroma-production.up.railway.app/*"]
  },
  "permissions": [
    "core:default",
    "core:event:default",
    "clipboard-manager:allow-read-text",
    "global-shortcut:default"
  ]
}
