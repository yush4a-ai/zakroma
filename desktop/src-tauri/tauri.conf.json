{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zakroma",
  "version": "0.1.0",
  "identifier": "com.yush4a.zakroma",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Закрома",
        "url": "https://zakroma-production.up.railway.app/",
        "width": 1280,
        "height": 820,
        "minWidth": 820,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["Russian"],
        "displayLanguageSelector": false
      }
    }
  }
}
